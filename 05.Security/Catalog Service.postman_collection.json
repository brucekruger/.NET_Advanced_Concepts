    {
      "name": "Get Token CartService API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.environment.set(\"access_token_cart_service\", response.access_token);\r",
              "pm.environment.set(\"refresh_token_cart_service\", response.refresh_token);\r",
              "\r",
              "console.log(\"Access Token saved: \" + response.access_token.substring(0, 50) + \"...\");\r",
              "console.log(\"Refresh Token saved: \" + response.refresh_token.substring(0, 50) + \"...\");\r",
              "console.log(\"Token expires in: \" + response.expires_in + \" seconds\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
