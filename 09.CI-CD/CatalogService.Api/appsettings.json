{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Information"
        }
    },
    "AllowedHosts": "*",
    "Authentication": {
        "Authority": "http://keycloak:8080/realms/microservices-realm",
        "Audience": "catalog-service",
        "ValidIssuer": "http://keycloak:8080/realms/microservices-realm"
    },
    "ConnectionStrings": {
        "MSSQL": "Server=catalog-db;Database=CatalogDB;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=true;MultipleActiveResultSets=true;"
    },
    "RabbitMq": {
        "HostName": "rabbitmq",
        "UserName": "guest",
        "Password": "guest",
        "VirtualHost": "/",
        "Port": 5672,
        "MaxRetryCount": 5,
        "RetryDelayMs": 3000,
        "ProductChangedQueueName": "products.changed",
        "ProductExchangeName": "catalog.products",
        "ProductRoutingKey": "product.changed",
        "DeadLetterQueueName": "products.changed.dlq",
        "DeadLetterExchangeName": "catalog.products.dlx"
    }
}
